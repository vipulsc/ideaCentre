# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local

# --- Next.js / local dev ---
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (NextAuth) ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase ---
# Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Database password (Project Settings → Database) — only for npm run db:migrate
SUPABASE_DB_PASSWORD=

# --- Google Gemini (AI features) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: bearer/x-health-token for GET /api/db/health (session also allowed)
HEALTH_CHECK_TOKEN=
