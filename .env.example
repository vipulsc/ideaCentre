# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local

# --- Next.js / local dev ---
# Local: http://localhost:3000
# Production MUST match the live origin users hit (include www if you use it):
#   NEXTAUTH_URL=https://www.ideacentre.xyz
NEXTAUTH_URL=http://localhost:3000

# Canonical public origin used for SEO (sitemap, canonical URLs, Open Graph,
# structured data). No trailing slash. Must be your real production domain.
#   NEXT_PUBLIC_SITE_URL=https://ideacentre.xyz
NEXT_PUBLIC_SITE_URL=https://ideacentre.xyz
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (NextAuth) ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (add both for prod):
#   http://localhost:3000/api/auth/callback/google
#   https://www.ideacentre.xyz/api/auth/callback/google
#   https://ideacentre.xyz/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase ---
# Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Database password (Project Settings → Database) — only for npm run db:migrate
SUPABASE_DB_PASSWORD=

# --- Google Gemini (AI features) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: bearer/x-health-token for GET /api/db/health (session also allowed)
HEALTH_CHECK_TOKEN=
